# Copy to apps/web/.env.local and adjust.
# Never commit real values: .env.local is git-ignored.

# Base URL of the Sowo backend (apps/api), without a trailing slash.
# Leave empty to use the built-in mock API at /api/mock (works offline).
# Example when running the real backend locally: http://localhost:8000
NEXT_PUBLIC_API_URL=

# Only with a backend: the API's address as seen from the web server (it can differ from the public one, for
# example http://api:8000 inside Docker). Defaults to NEXT_PUBLIC_API_URL. The browser never calls the API itself:
# it calls this site's /api/proxy, which keeps the vendor's session in an httpOnly cookie. Sign-in lives at /login.
API_INTERNAL_URL=

# Public GitHub URL shown on the landing page.
NEXT_PUBLIC_GITHUB_URL=https://github.com/adeyanjufuhad/sowo
