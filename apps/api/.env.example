DATABASE_URL=sqlite:///./sowo.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
WHATSAPP_VERIFY_TOKEN=replace_me
WHATSAPP_APP_SECRET=replace_me
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_ECHO_MODE=false
PAYSTACK_SECRET_KEY=replace_me
PUBLIC_BASE_URL=http://localhost:8000
REPLY_DELAY_SECONDS=3
STOCK_HOLD_MINUTES=15
CORS_ORIGINS=http://localhost:3000

# Qwen3 tool loop
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.3

# WhatsApp: version of Meta's Graph API, and the vendor's own number for "pack this order" alerts
WHATSAPP_GRAPH_VERSION=v23.0
VENDOR_ALERT_PHONE=

# Paystack: where the buyer lands after paying (optional) and the domain used to build the
# placeholder email Paystack requires for each buyer
PAYSTACK_CALLBACK_URL=
PAYSTACK_CUSTOMER_EMAIL_DOMAIN=customers.sowo.invalid

# The /simulator/* endpoints power the web app's buyer simulator. Set to false for a deployment with real buyers.
SIMULATOR_ENABLED=true
