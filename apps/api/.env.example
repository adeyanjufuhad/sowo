# SQLite for development. Postgres for anything real, e.g. postgresql://user:password@host:5432/sowo
DATABASE_URL=sqlite:///./sowo.db
# Neon or any host with a connection pooler: DATABASE_URL is the pooled URL (host contains "-pooler") and
# DATABASE_URL_DIRECT is the unpooled one, used only to run migrations. Leave it empty otherwise.
# Paste URLs straight from the console; postgresql:// is rewritten for the driver.
DATABASE_URL_DIRECT=
# Where Qwen3 runs: "ollama" (a local Ollama, the default) or "openai" (a hosted OpenAI-compatible endpoint such as
# Groq, OpenRouter or Cloudflare Workers AI, so nothing runs on your own machine). Put the key here, never in code.
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# For MODEL_PROVIDER=openai, for example on Groq (check the host for the current open-weight Qwen3 model id):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=replace_me
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_REASONING_EFFORT=none
WHATSAPP_VERIFY_TOKEN=replace_me
WHATSAPP_APP_SECRET=replace_me
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_ECHO_MODE=false
PAYSTACK_SECRET_KEY=replace_me
PUBLIC_BASE_URL=http://localhost:8000
REPLY_DELAY_SECONDS=3
STOCK_HOLD_MINUTES=15
CORS_ORIGINS=http://localhost:3000

# Qwen3 tool loop
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.3

# WhatsApp: version of Meta's Graph API. Each vendor's own WhatsApp number, alert phone and payment details are
# stored on their row in the database and set from the dashboard (PATCH /vendor/settings), not here.
WHATSAPP_GRAPH_VERSION=v23.0

# Paystack: where the buyer lands after paying (optional) and the domain used to build the
# placeholder email Paystack requires for each buyer
PAYSTACK_CALLBACK_URL=
PAYSTACK_CUSTOMER_EMAIL_DOMAIN=customers.sowo.invalid

# Logging: json (one object per line, for a log host) or text (for a terminal). Phone numbers and tokens are masked.
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# Rate limits per client address per minute (kept in each process's memory). Failed sign-ins are also limited per email.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_WEBHOOKS_PER_MINUTE=600
# LOGIN_MAX_FAILURES=10
# Only when the API is reachable through a trusted proxy alone (the web app forwards the visitor's address as
# x-forwarded-for): name the header that carries the real client address. Leave empty otherwise, or it can be spoofed.
# CLIENT_IP_HEADER=x-forwarded-for

# The /simulator/* endpoints power the web app's /try demo page and have no sign-in, so they are off unless you
# turn them on. On your own machine: SIMULATOR_ENABLED=true, plus ENVIRONMENT=development so the demo commands
# (python -m app.seed, app.seed_demo, app.chat_cli) are allowed. Never set either on a real deployment.
SIMULATOR_ENABLED=false
# ENVIRONMENT=development

# The shop the simulator's chats belong to (the demo shop made by `python -m app.seed`).
SIMULATOR_VENDOR_NAME=Ada's Footwear

# How long a bank-transfer order holds stock (vendors choose bank transfer in their settings)
MANUAL_PAYMENT_HOLD_MINUTES=180
